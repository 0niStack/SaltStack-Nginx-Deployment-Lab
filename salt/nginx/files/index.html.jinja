<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ salt['pillar.get']('nginx:title', 'Salt Nginx') }}</title>
  <style>
    body { font-family: system-ui, sans-serif; background:#0f172a; color:#e2e8f0;
           display:grid; place-items:center; min-height:100vh; margin:0; }
    .card { background:#1e293b; padding:2rem 3rem; border-radius:12px; text-align:center; }
    code { color:#38bdf8; }
  </style>
</head>
<body>
  <div class="card">
    <h1>{{ salt['pillar.get']('nginx:title', 'Salt Nginx') }}</h1>
    <p>Served by minion <code>{{ grains['id'] }}</code></p>
    <p>IP: <code>{{ grains['fqdn_ip4'][0] if grains.get('fqdn_ip4') else 'n/a' }}</code></p>
    <p>OS: {{ grains['os'] }} {{ grains['osrelease'] }}</p>
  </div>
</body>
</html>
